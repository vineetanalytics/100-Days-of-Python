# Day 1 -- Introduction to Python

# In day 1 we are going to learn 3 basic concepts of python.

# 1. print() -- showes the output on screen.

print("Hello World!")
print("My name is Vineet")
print("I am learning Python")

# Output:-
# Hello World!
# my name is Vineet
# I am learning Python

# 2. Variables -- its stores the data in variables.

name = "Vineet"             # Name is variable & "Vineet" is string value 
age = 19                    # Age is variable & 19 is integer value
course = "Data Analytics"   # Course is variable & "Data Analytics" is string value

print(name)
print(age)
print(course)

# Name, Age, Course -- this are variables.

# 3. Basic Calculation.

a = 20
b = 10

print(a + b)    # + is use for Addition.
print(a - b)    # - is use for Subtraction.
print(a * b)    # * is use for Multiplication.
print(a / b)    # / is use for division.

# Output:-
# 30
# 10
# 200
# 2.0


